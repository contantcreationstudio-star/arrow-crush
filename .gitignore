# Godot cache (rebuilt automatically when the project opens)
.godot/

# Exported builds and old APK backups (can be rebuilt from the code)
build/
*.apk
*.aab
*.idsig
*.apk.bak

# Android build template outputs (regenerated by Godot / Gradle)
android/build/build/
android/build/.gradle/
android/build/libs/

# Signing keys and secrets: NEVER upload. Back these up on Drive + pen drive.
*.keystore
*.jks
*.p12
export_credentials.cfg
.godot/export_credentials.cfg

# OS / editor junk
Thumbs.db
desktop.ini
.DS_Store
*.tmp

# Downloaded icon sets (source for tools/build_pictures.gd; the processed result is data/pictures.txt)
tools/icon_src/
